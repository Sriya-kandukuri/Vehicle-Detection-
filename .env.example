# Change this value before deploying the application.
SECRET_KEY=replace-with-a-long-random-value

# Accurate YOLOv8 inference is enabled by default. Set to 0 only when running
# the lightweight OpenCV demonstration fallback without model dependencies.
USE_YOLO=1

# Local .pt path, or yolov8n.pt for the Ultralytics default model.
YOLO_WEIGHTS=yolov8n.pt

# Maximum request/upload size in megabytes. Default: 2048 (2 GB).
MAX_UPLOAD_MB=2048
